# ==============================================================================
# Student Management System - Docker Environment Configuration
# Copy this file to .env at the project root before running Docker Compose:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# NOTE: The .env file contains sensitive secrets and is excluded from Git (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED: Backend JWT Secret Key
# ------------------------------------------------------------------------------
# The backend will refuse to start if SECRET_KEY is not defined.
# Generate a secure 64-character random key using Python or OpenSSL:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_key_min_32_chars

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
# These credentials initialize the PostgreSQL container and are used by the backend.
# NOTE ON SPECIAL CHARACTERS:
# If your password contains special characters (@, :, /, #, %, etc.), the backend
# automatically URL-encodes them when assembling the connection string.
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=sms_password
POSTGRES_DB=student_management

# Optional: Full Database URL override.
# If set, this overrides POSTGRES_USER/PASSWORD/DB when connecting.
# WARNING: If setting DATABASE_URL manually with special characters in the password,
# you MUST percent-encode them yourself (e.g., '@' -> '%40', ':' -> '%3A').
# DATABASE_URL=postgresql://sms_user:sms_password@db:5432/student_management

# ------------------------------------------------------------------------------
# 3. Host Port Mappings
# ------------------------------------------------------------------------------
# Non-conflicting defaults to prevent collisions with native Windows services:
# - DB_HOST_PORT: 5433 (avoids native Windows PostgreSQL running on port 5432)
# - BACKEND_HOST_PORT: 8001 (avoids native Uvicorn running on port 8000)
# - FRONTEND_PORT: 80 (standard HTTP port served by NGINX)
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8001
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 4. Backend Environment & CORS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ------------------------------------------------------------------------------
# 5. Frontend API Target
# ------------------------------------------------------------------------------
# Relative path routed through the NGINX reverse proxy inside Docker
VITE_API_BASE_URL=/api/v1
